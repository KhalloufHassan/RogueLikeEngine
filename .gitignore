# Unity package repository: only the package's own files are versioned.
# .meta files must be committed, Unity needs them to import the package.

# IDE and generated project files
.idea/
.vs/
.vscode/
*.csproj
*.sln
*.user
*.userprefs
*.DotSettings.user
obj/
bin/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Unity crash and log files
sysinfo.txt
*.log
